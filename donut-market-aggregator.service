[Unit]
Description=DonutSMP market stats aggregator
After=network-online.target donut-market.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/donut-market
EnvironmentFile=/root/donut-market/.env.dashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/donut-market/collector.py --aggregate-once --candle-lookback-minutes 180

[Install]
WantedBy=multi-user.target
