[Unit]
Description=DonutSMP market database maintenance
After=donut-market.service

[Service]
Type=oneshot
WorkingDirectory=/root/donut-market
EnvironmentFile=/root/donut-market/.env.dashboard
ExecStart=/usr/bin/python3 /root/donut-market/maintenance.py --postgres --listing-retention-hours 30 --sales-retention-days 90 --skip-eligible-counts --ensure-indexes
